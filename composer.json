{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tory/tory",
    "type": "project",
    "description": "A household inventory that answers one question: where is that thing?",
    "keywords": ["inventory", "household", "laravel", "filament"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "chillerlan/php-qrcode": "^5.0",
        "dedoc/scramble": "^0.13.53",
        "filament/filament": "^5.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.1",
        "laravel/passport": "^13.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/livewire": "^4.1",
        "pontedilana/php-weasyprint": "^2.7",
        "spatie/laravel-pdf": "^2.14"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.4",
        "psalm/plugin-laravel": "^3.17",
        "rector/rector": "^2.8",
        "vimeo/psalm": "^6.21"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php -r \"file_exists('storage/oauth-private.key') && file_exists('storage/oauth-public.key') || passthru('php artisan passport:keys --force --no-interaction');\"",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "refactor": [
            "rector process"
        ],
        "refactor:check": [
            "rector process --dry-run"
        ],
        "security:check": [
            "psalm --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@refactor:check",
            "@types:check",
            "@security:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
